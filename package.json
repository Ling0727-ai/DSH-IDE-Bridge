{
  "name": "dsh-ide-bridge",
  "version": "0.4.0",
  "description": "DeepSeek Harness IDE tools, standalone semantic editing, project onboarding and persistent memories",
  "bridgeCore": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib",
    "core",
    "SERENA-PARITY.md",
    "CORE.md",
    "cordis.patch.yml",
    "dist/dsh-ide-bridge-vscode-0.3.0.vsix",
    "dist/dsh-ide-bridge-jetbrains-0.3.0.zip",
    "skills",
    "scripts/install-skill.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check lib/bridge-client.js && node --check lib/tool-definitions.js && node --check vscode-extension/extension.js",
    "install:skill": "node scripts/install-skill.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "vscode",
    "ide",
    "plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "typescript": "5.9.3",
    "pyright": "1.1.407",
    "ignore": "7.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
